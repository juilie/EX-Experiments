{{!< default}}

<!-- Landing section - first screen -->
<div id="landing-section">
	<div id="landing-card-wrapper">
		<div class="agency-card pixel-window">
			<div class="window-titlebar">
				<div class="window-title">EX Research</div>
				<div class="window-controls">
					<div class="window-control" title="Minimize"><span>–</span></div>
					<div class="window-control" title="Resize"><span>□</span></div>
					<div class="window-control" title="Close"><span>×</span></div>
				</div>
			</div>
			<div class="title-card-body">
				<div id="three-title"></div>
				<p id="landing-subtitle">EX Research helps you stay ahead of the internet.</p>
				<button id="enter-button">Enter Site</button>
			</div>
			<div class="window-scanlines"></div>
			<div class="status-bar">
				<span>Website v1.0</span>
				<span>Connected...</span>
			</div>
		</div>
	</div>
</div>

<!-- Content Section (services, newsletter, articles) -->
<div id="content-section">
	<div id="homepage-ui">
		<div class="section-header" id="how-we-help-header">
			<div class="typing-indicator" id="typing-indicator">
				<div class="typing-dot"></div>
				<div class="typing-dot"></div>
				<div class="typing-dot"></div>
			</div>
			<h2 class="section-header-title" id="section-title">How We Help</h2>
		</div>

		<div class="services-section">
			<div class="service-card">
				<div class="service-browser-window">
					<div class="service-browser-window-titlebar">
						<div class="service-browser-window-titlebar-title">Research</div>
						<div class="service-browser-window-titlebar-buttons">
							<div class="service-browser-window-titlebar-button">–</div>
							<div class="service-browser-window-titlebar-button">□</div>
							<div class="service-browser-window-titlebar-button">×</div>
						</div>
					</div>
					<div class="service-browser-content research-bg">
						<h3 class="service-title">Research</h3>
						<p class="service-description">Deep dives into data and communities to explain what's lighting up the dashboard.</p>
					</div>
				</div>
			</div>
			<div class="service-card">
				<div class="service-browser-window">
					<div class="service-browser-window-titlebar">
						<div class="service-browser-window-titlebar-title">Strategy</div>
						<div class="service-browser-window-titlebar-buttons">
							<div class="service-browser-window-titlebar-button">–</div>
							<div class="service-browser-window-titlebar-button">□</div>
							<div class="service-browser-window-titlebar-button">×</div>
						</div>
					</div>
					<div class="service-browser-content strategy-bg">
						<h3 class="service-title">Strategy</h3>
						<p class="service-description">Bullshit-free plans of action that survive contact with tomorrow's internet.</p>
					</div>
				</div>
			</div>
			<div class="service-card">
				<div class="service-browser-window">
					<div class="service-browser-window-titlebar">
						<div class="service-browser-window-titlebar-title">Curation</div>
						<div class="service-browser-window-titlebar-buttons">
							<div class="service-browser-window-titlebar-button">–</div>
							<div class="service-browser-window-titlebar-button">□</div>
							<div class="service-browser-window-titlebar-button">×</div>
						</div>
					</div>
					<div class="service-browser-content curation-bg">
						<h3 class="service-title">Curation</h3>
						<p class="service-description">Cultural insights across music, games, internet culture, and more.</p>
					</div>
				</div>
			</div>
			<div class="service-card">
				<div class="service-browser-window">
					<div class="service-browser-window-titlebar">
						<div class="service-browser-window-titlebar-title">Creative</div>
						<div class="service-browser-window-titlebar-buttons">
							<div class="service-browser-window-titlebar-button">–</div>
							<div class="service-browser-window-titlebar-button">□</div>
							<div class="service-browser-window-titlebar-button">×</div>
						</div>
					</div>
					<div class="service-browser-content creative-bg">
						<h3 class="service-title">Creative</h3>
						<p class="service-description">Copy that can code switch from corporate polish to social lunacy.</p>
					</div>
				</div>
			</div>
		</div>

		<div class="newsletter-clients-wrapper">
			<div class="newsletter-wrapper">
				<img src="{{asset "images/stickersub.png"}}" alt="Subscribe sticker" class="newsletter-sticker">
				<div class="newsletter-window">
					<div class="window-titlebar">
						<div class="window-title">Subscribe</div>
						<div class="window-controls">
							<div class="window-control" title="Minimize"><span>–</span></div>
							<div class="window-control" title="Resize"><span>□</span></div>
							<div class="window-control" title="Close"><span>×</span></div>
						</div>
					</div>
					
					<div id="newsletter-cloud-bg"></div>
					<div class="newsletter-content">
						<h3 class="newsletter-title">We take the internet weirdly seriously</h3>
						<p class="newsletter-description">Subscribe to our newsletter for a weekly download of cultural picks, super-online trends, and deep-internet explainers.</p>
						<form class="newsletter-form">
							<input type="email" class="newsletter-input" placeholder="Enter your email" required>
							<button type="submit" class="newsletter-button">READ NOW</button>
						</form>
						<div class="newsletter-cta">
							{{#get "posts" limit="1"}}
								{{#foreach posts}}
									<a href="{{url}}" class="newsletter-cta-link">Check out our latest research report →</a>
								{{/foreach}}
							{{/get}}
						</div>
					</div>
					<div class="window-scanlines"></div>
					<div class="status-bar">
						<span>Newsletter v1.0</span>
						<span>Ready</span>
					</div>
				</div>
			</div>

			<div class="clients-wrapper">
				<div class="clients-window">
					<div class="window-titlebar">
						<div class="window-title">About EX</div>
						<div class="window-controls">
							<div class="window-control" title="Minimize"><span>–</span></div>
							<div class="window-control" title="Resize"><span>□</span></div>
							<div class="window-control" title="Close"><span>×</span></div>
						</div>
					</div>
					<div class="clients-content">
						<div class="client-chatbox client-chatbox-left">
							<div class="client-chatbox-label">Marketing Agencies</div>
							<div class="client-chatbox-text">We bolt on easily to existing projects to provide quick-hit expertise.</div>
						</div>
						<div class="client-chatbox client-chatbox-right">
							<div class="client-chatbox-label">Culture Industry</div>
							<div class="client-chatbox-text">We help games, music, and other culture orgs pull off and promote new ideas.</div>
						</div>
						<div class="client-chatbox client-chatbox-left">
							<div class="client-chatbox-label">Tech Companies</div>
							<div class="client-chatbox-text">We help marketers understand and work with deep-internet culture and communities.</div>
						</div>
					</div>
					<div class="window-scanlines"></div>
					<div class="status-bar">
						<span>About v1.0</span>
						<span>Ready</span>
					</div>
				</div>
			</div>
		</div>
		
		<div class="articles-section">
			<div class="articles-browser-window">
				<div class="articles-browser-titlebar">
					<div class="articles-browser-titlebar-title">Articles</div>
					<div class="articles-browser-titlebar-buttons">
						<div class="articles-browser-titlebar-button">–</div>
						<div class="articles-browser-titlebar-button">□</div>
						<div class="articles-browser-titlebar-button">×</div>
					</div>
				</div>
				<div class="articles-browser-content">
					<div class="section-header" id="recent-posts-header">
						<div class="typing-indicator" id="recent-posts-typing-indicator">
							<div class="typing-dot"></div>
							<div class="typing-dot"></div>
							<div class="typing-dot"></div>
						</div>
						<h2 class="section-header-title" id="recent-posts-title">Recent Posts</h2>
					</div>
					<div class="articles-grid" id="articles-grid">
						{{#foreach posts}}
							<a href="{{url}}" class="article-card windowized">
								<div class="agency-card pixel-window">
									<div class="window-titlebar">
										<div class="window-title">{{title}}</div>
										<div class="window-controls">
											<div class="window-control" title="Minimize"><span>–</span></div>
											<div class="window-control" title="Resize"><span>□</span></div>
											<div class="window-control" title="Close"><span>×</span></div>
										</div>
									</div>
									<div class="card-body">
										{{#if feature_image}}
											<div class="article-preview" style="background-image: url('{{feature_image}}')"></div>
										{{/if}}
										<div class="article-content">
											{{#if primary_tag}}
												<div class="article-category">{{primary_tag.name}}</div>
											{{/if}}
											<h3 class="article-title">{{title}}</h3>
											<p class="article-excerpt">{{excerpt words="20"}}</p>
											<div class="article-meta">
												<span class="article-date">{{date format="MMM D, YYYY"}}</span>
											</div>
										</div>
									</div>
									<div class="window-scanlines"></div>
								</div>
							</a>
						{{/foreach}}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<script type="module" src="{{asset "js/articles-threejs.js"}}"></script>

