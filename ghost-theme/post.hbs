{{!< default}}

<div id="homepage-ui">
	<div class="article-window">
		<div class="window-titlebar">
			<div class="window-title">{{title}}</div>
			<div class="window-controls">
				<div class="window-control" title="Minimize"><span>–</span></div>
				<div class="window-control" title="Resize"><span>□</span></div>
				<div class="window-control" title="Close"><span>×</span></div>
			</div>
		</div>
		
		<div class="window-toolbar">
			<div class="toolbar-chip">Article</div>
			<div class="address-bar"></div>
		</div>
		
		<div class="content">
			<h1 class="article-title">{{title}}</h1>
			{{#if custom_excerpt}}
				<p class="article-subtitle">{{custom_excerpt}}</p>
			{{/if}}
			
			<div class="article-meta">
				<p>
					{{#primary_author}}
						<span>{{name}}</span>
					{{/primary_author}}
					{{#if primary_tag}}
						<span>•</span>
						<span>{{primary_tag.name}}</span>
					{{/if}}
					<span>•</span>
					<time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time>
				</p>
			</div>
			
			{{#if feature_image}}
				<figure class="image">
					<img src="{{img_url feature_image size="l"}}" alt="{{title}}">
				</figure>
			{{/if}}
			
			<div class="article-content">
				{{content}}
			</div>
		</div>
		
		<div class="window-scanlines"></div>
	</div>
</div>

<canvas id="water-canvas"></canvas>

<!-- SimplexNoise and GPUComputationRenderer needed for water animation -->
<script src="https://cdn.jsdelivr.net/npm/three@0.168.0/examples/js/math/SimplexNoise.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.168.0/examples/js/misc/GPUComputationRenderer.js"></script>
<script type="module" src="{{asset "js/article-water.js"}}"></script>

